---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { bild } from '../lib/bilder';
import faq from '../data/faq.json';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.frage, acceptedAnswer: { '@type': 'Answer', text: f.antwort } })),
};
---
<Base title="FAQ" description="Die meistgestellten Fragen an die Schatullen: Sortiment, Gravur, Briefmarken, Versand, Drachenreparatur, Tee und Wangerland-Souvenirs." schema={[schema]}>
  <PageHero eyebrow="FAQ" titel="Die meistgestellten Fragen" foto={bild('gummistiefel')} alt="Gummistiefel im Regal" />
  <section class="container-page mt-10 max-w-3xl">
    <div class="divide-y divide-navy/10 rounded-3xl bg-white ring-1 ring-navy/10">
      {faq.map((f) => (
        <details class="group p-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-navy [&::-webkit-details-marker]:hidden">
            {f.frage}
            <span class="mt-0.5 text-xl leading-none text-petrol-700 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-navy-950/80">{f.antwort}</p>
        </details>
      ))}
    </div>
    <p class="mt-8 text-navy-950/80">Noch eine Frage? <a href={u('/kontakt/')} class="font-medium text-navy">Ruft uns an oder schreibt uns.</a></p>
  </section>
</Base>
