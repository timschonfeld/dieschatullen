---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClickEmbed from '../components/ClickEmbed.astro';
import { bild, bildOder } from '../lib/bilder';
import { site } from '../lib/laden';
import videos from '../data/videos.json';

for (const v of videos) if (!/^[\w-]{11}$/.test(v.id)) throw new Error(`Ungültige YouTube-ID: ${v.id}`);
const themen = [...new Set(videos.map((v) => v.thema))];
---
<Base title="Drachen-Videos: Lenkdrachen & Lenkmatten aufbauen" description="Nicky von den Schatullen zeigt in kurzen Videos, wie ihr Lenkdrachen und Lenkmatten auf- und abbaut, Leinen befestigt und welches Zubehör hilft.">
  <PageHero eyebrow="Videos" titel="Nicky erklärt's" foto={bild('lenkmatten')} alt="Bunte Lenkmatten im Drachennest"
    intro="Wie baue ich meinen Lenkdrachen auf? Wofür brauche ich eine Lenkbar? In kurzen Videos zeigt euch Nicky, worauf es beim jeweiligen Modell ankommt." />

  {themen.map((thema) => (
    <section class="container-page mt-16 md:mt-20">
      <h2 class="mb-8 text-3xl md:text-4xl">{thema}</h2>
      <div class="grid gap-x-6 gap-y-10 md:grid-cols-2">
        {videos.filter((v) => v.thema === thema).map((v) => (
          <article>
            <ClickEmbed src={`https://www.youtube-nocookie.com/embed/${v.id}?autoplay=1&rel=0`} titel={`${v.titel} abspielen`} anbieter="YouTube" poster={bildOder(`video-${v.id}`, 'lenkmatten')} alt="" />
            <h3 class="mt-4 text-2xl">{v.titel}</h3>
            <p class="mt-1 text-lg text-navy-950/75">{v.text}</p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="container-page mt-20">
    <div class="rounded-lg bg-petrol-50 p-8 sm:p-12">
      <h2 class="text-2xl sm:text-3xl">Noch Fragen zu eurem Drachen?</h2>
      <p class="mt-3 max-w-2xl text-lg text-navy-950/80">Kommt einfach in einer der Schatullen vorbei, wir helfen euch gern weiter. Alle Videos findet ihr auch auf unserem YouTube-Kanal.</p>
      <a href={site.youtube} class="btn-primary mt-6" rel="noopener">YouTube-Kanal öffnen</a>
    </div>
  </section>
</Base>
