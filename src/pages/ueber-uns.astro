---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { bild } from '../lib/bilder';
import jobs from '../data/jobs.json';

const team = [
  { name: 'Nicky', rolle: 'Inhaberin', bild: 'team-nicky', text: 'Aufgewachsen in Wilhelmshaven, hatte Nicky schon von klein auf eine Affinität zur Nordsee. Vom Drachenfliegen ist sie zum Kitesurfen gekommen und reist zwischen den Saisons gerne an andere Meere. Immer für einen guten Schnack zu haben.' },
  { name: 'Nadja', rolle: 'Kernteam', bild: 'team-nadja' },
  { name: 'Stinker', rolle: 'Ladenkater', bild: 'stinker', text: 'Hält in Hooksiel die Stellung, am liebsten im Körbchen.' },
];
---
<Base title="Über uns" description="Seit 2000 in Hooksiel, seit 2021 auch in Schillig: Lernt Nicky, Nadja und Ladenkater Stinker von den Schatullen kennen.">
  <PageHero eyebrow="Über uns" titel="Ein Stück Meer zum Mitnehmen" foto={bild('laden-hooksiel-himmel')} alt="Die Hooksieler Schatulle und das Drachennest unter blauem Himmel"
    intro="Uns, den Souvenirladen Hooksieler Schatulle und das Drachennest, gibt es schon seit 2000 in der Langen Straße 38 in Hooksiel. Gegründet von Britta Schwarting, hat Nicky das Geschäft 2015 übernommen und stetig weiter ausgebaut. 2021 ist die Schillige Schatulle dazugekommen." />

  <section class="container-page mt-20">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl">Das Kernteam</h2>
      <p class="mt-3 text-navy-950/80">Wir sind alle große Nordsee-Fans. Wir lieben das Meer und wollen euch ein Stück davon mit nach Hause geben.</p>
    </div>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((t) => (
        <li class="overflow-hidden rounded-3xl bg-white ring-1 ring-navy/10">
          <Image src={bild(t.bild)} alt={`${t.name}, ${t.rolle}`} widths={[400, 700]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          <div class="p-6">
            <p class="eyebrow">{t.rolle}</p>
            <h3 class="mt-1 text-2xl">{t.name}</h3>
            {t.text && <p class="mt-3 leading-relaxed text-navy-950/80">{t.text}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page mt-20">
    <div class="rounded-3xl bg-petrol-50 p-8 sm:p-12">
      <h2 class="text-2xl sm:text-3xl">Du möchtest Teil unseres Teams werden?</h2>
      <p class="mt-3 max-w-2xl text-navy-950/80">Neben dem Kernteam haben wir immer tolle Aushilfen und Semesterferien-Jobber. {jobs.aktiv && jobs.text}</p>
      <a href={u('/jobs/')} class="btn-primary mt-6">Zu den Jobs</a>
    </div>
  </section>
</Base>
