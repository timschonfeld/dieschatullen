---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { bild } from '../lib/bilder';
import jobs from '../data/jobs.json';

const betreff = encodeURIComponent('Bewerbung Die Schatullen');
---
<Base title="Jobs" description="Aushilfen, Semesterferien-Jobs und Schülerjobs in Hooksiel und Schillig: Werdet Teil der Schatullen.">
  <PageHero eyebrow="Jobs" titel={jobs.aktiv ? jobs.titel : 'Werde Teil der Schatullen'} foto={bild('nadja-nicky')} alt="Nadja und Nicky in der Schilligen Schatulle"
    intro={jobs.aktiv ? jobs.text : 'Gerade suchen wir niemanden, aber Initiativbewerbungen freuen uns immer.'}>
    {jobs.aktiv && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {jobs.gesucht.map((g) => <li class="rounded-full bg-petrol-50 px-4 py-1.5 text-sm font-medium text-petrol-700">{g}</li>)}
      </ul>
    )}
  </PageHero>

  <section class="container-page mt-16 max-w-3xl">
    <div class="rounded-3xl bg-white p-8 ring-1 ring-navy/10 sm:p-10">
      <h2 class="text-2xl sm:text-3xl">So bewerbt ihr euch</h2>
      <p class="mt-3 leading-relaxed text-navy-950/80">Schreibt uns einfach eine kurze Mail: wer ihr seid, in welchem Zeitraum ihr Zeit habt und ob ihr lieber in Hooksiel oder Schillig arbeiten möchtet.</p>
      <a href={`mailto:${jobs.email}?subject=${betreff}`} class="btn-primary mt-6">Bewerbung an {jobs.email}</a>
    </div>
  </section>
</Base>
