---
/**
 * Drachenwetter: aktueller Wind in Beaufort mit Ampel (bis 4 Bft = gut), Böen, Richtung und 12-Stunden-Vorschau.
 * Datenquelle: Deutscher Wetterdienst über Bright Sky (frei nutzbar, auch kommerziell). Auf Hetzner (PUBLIC_WIND_PROXY gesetzt) kommen die Daten über /api/wind.php,
 * sodass der Browser keine Verbindung zu Dritten aufbaut.
 */
import { laeden } from '../lib/laden';
import { u } from '../lib/url';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang?: Lang; variante?: 'gross' | 'kompakt'; link?: string }
const { lang = 'de', variante = 'gross', link } = Astro.props;
const t = ui[lang].wind;
const orte = [...laeden].reverse().map((l) => ({ id: l.id, name: l.ort, lat: l.lat, lon: l.lon })); // Schillig (Strand) zuerst
const proxy = import.meta.env.PUBLIC_WIND_PROXY ? u('/api/wind.php') : '';
const config = JSON.stringify({ orte, proxy, t, lang });
const skala = [0, 1, 2, 3, 4, 5, 6, 7, 8];
const zoneFarbe = (b: number) => (b <= 1 ? 'var(--wind-wenig)' : b <= 4 ? 'var(--wind-gut)' : 'var(--wind-viel)');
---
{variante === 'kompakt' ? (
  <a href={link} class="drachenwetter group inline-flex items-center gap-3 rounded-full bg-white/10 py-2 pl-2 pr-5 text-white no-underline ring-1 ring-white/25 backdrop-blur hover:bg-white/20" data-config={config} data-variante="kompakt">
    <span data-w="bft" class="grid h-11 w-11 place-items-center rounded-full bg-white/20 font-display text-lg font-bold">–</span>
    <span class="text-sm leading-tight"><span class="block text-white/75">{t.jetzt} in {orte[0].name}</span><span data-w="urteil" class="font-semibold">{t.laedt}</span></span>
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
  </a>
) : (
  <div id="drachenwetter" class="drachenwetter scroll-mt-24 overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-navy/5 ring-1 ring-navy/10" data-config={config} data-variante="gross">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-navy/10 px-6 py-5 md:px-10">
      <h2 class="text-3xl md:text-4xl">{t.titel}</h2>
      <div class="flex rounded-full bg-sand-100 p-1" role="tablist" aria-label={t.ort}>
        {orte.map((o, i) => (
          <button type="button" role="tab" data-ort={o.id} aria-selected={i === 0 ? 'true' : 'false'} class="rounded-full px-4 py-2 text-sm font-semibold text-navy aria-selected:bg-navy aria-selected:text-white">{o.name}</button>
        ))}
      </div>
    </div>

    <div class="grid gap-8 p-6 md:grid-cols-[auto_1fr] md:gap-12 md:p-10">
      <!-- Aktueller Wert -->
      <div class="flex items-center gap-6">
        <div data-w="kreis" class="relative grid h-36 w-36 shrink-0 place-items-center rounded-full text-white transition-colors md:h-44 md:w-44" style="background: var(--wind-leer)">
          <div class="text-center">
            <span data-w="bft" class="block font-display text-6xl font-bold leading-none md:text-7xl">–</span>
            <span class="text-sm font-semibold tracking-wider">Bft</span>
          </div>
          <svg data-w="pfeil" class="absolute -right-2 -top-2 h-12 w-12 rounded-full bg-white p-2 text-navy shadow-md transition-transform duration-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l5 14-5-3-5 3z" /></svg>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-navy-950/70">{t.jetzt}</p>
          <p data-w="beschreibung" class="font-display text-2xl font-bold text-navy">{t.laedt}</p>
          <p data-w="details" class="mt-1 text-navy-950/70"></p>
        </div>
      </div>

      <!-- Urteil + Skala -->
      <div class="flex flex-col justify-center">
        <p data-w="urteil" class="inline-flex self-start rounded-full px-4 py-1.5 text-sm font-bold text-white" style="background: var(--wind-leer)">…</p>
        <p data-w="urteilText" class="mt-3 text-lg leading-relaxed text-navy-950/85"></p>
        <p data-w="boeen" class="mt-3 hidden rounded-2xl bg-signal/10 px-4 py-3 text-sm font-medium text-signal"></p>

        <div class="mt-8" aria-hidden="true">
          <div class="relative">
            <div class="grid grid-cols-9 gap-1">
              {skala.map((b) => (
                <div class="h-4 rounded-full first:rounded-l-full" style={`background:${zoneFarbe(b)}; opacity:.9`}></div>
              ))}
            </div>
            <div data-w="marker" class="absolute -top-3 hidden h-10 w-1.5 -translate-x-1/2 rounded-full bg-navy shadow ring-2 ring-white transition-[left] duration-700"></div>
            <div data-w="boemarker" class="absolute -top-2 hidden h-8 w-0 -translate-x-1/2 border-l-2 border-dashed border-navy/60 transition-[left] duration-700"></div>
          </div>
          <div class="mt-2 grid grid-cols-9 text-center text-xs font-semibold text-navy-950/70">
            {skala.map((b) => <span>{b === 8 ? '8+' : b}</span>)}
          </div>
          <div class="mt-1 grid grid-cols-9 text-center text-[11px] uppercase tracking-wider">
            <span class="col-span-2" style="color: var(--wind-wenig-text)">{t.zone[0]}</span>
            <span class="col-span-3 font-bold" style="color: var(--wind-gut-text)">{t.zone[1]} · 2–4</span>
            <span class="col-span-4" style="color: var(--wind-viel)">{t.zone[2]}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 12-Stunden-Vorschau -->
    <div class="border-t border-navy/10 px-6 py-6 md:px-10">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-navy-950/70">{t.naechste}</p>
      <div data-w="stunden" class="grid grid-cols-12 items-end gap-1.5 md:gap-3"></div>
    </div>

    <!-- Regel -->
    <div class="flex gap-4 bg-navy px-6 py-6 text-white md:px-10">
      <svg class="mt-0.5 h-7 w-7 shrink-0 text-sand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <div>
        <p class="font-display text-lg font-bold text-sand">{t.regelTitel}</p>
        <p class="mt-1 text-lg leading-relaxed">{t.regel}</p>
      </div>
    </div>
    <p class="px-6 py-3 text-right text-xs text-navy-950/70 md:px-10">{t.quelle}: <a href="https://www.dwd.de/" rel="noopener" class="underline">Deutscher Wetterdienst</a>, über <a href="https://brightsky.dev/" rel="noopener" class="underline">Bright Sky</a> · {t.messung}</p>
  </div>
)}

<style is:global>
  :root { --wind-wenig: #9db6cc; --wind-wenig-text: #4a6784; --wind-gut-text: #1d7650; --wind-gut: #2f9e6e; --wind-viel: #c8412f; --wind-leer: #b9c3cf; }
</style>

<script>
  type Ort = { id: string; name: string; lat: number; lon: number };
  type Daten = { current: { time: string; wind_speed_10m: number; wind_gusts_10m: number; wind_direction_10m: number }; hourly: { time: string[]; wind_speed_10m: number[]; wind_gusts_10m: number[] } };

  const GRENZEN = [1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118];
  const bft = (kmh: number) => { const i = GRENZEN.findIndex((g) => kmh < g); return i === -1 ? 12 : i; };
  const zone = (b: number) => (b <= 1 ? 'wenig' : b <= 4 ? 'gut' : 'viel');
  const farbe = (b: number) => `var(--wind-${zone(b)})`;
  const cache = new Map<string, Promise<Daten>>();

  // Bright Sky (Daten des Deutschen Wetterdienstes): aktuelle Messung der nächsten Station + stündliche Vorhersage
  const erster = (...w: (number | null | undefined)[]) => w.find((x) => typeof x === 'number') ?? 0;
  async function brightSky(ort: Ort): Promise<Daten> {
    const q = `lat=${ort.lat}&lon=${ort.lon}&tz=Europe/Berlin`;
    const von = new Date(); von.setMinutes(0, 0, 0);
    const bis = new Date(von.getTime() + 13 * 3600e3);
    const [jetzt, vorhersage] = await Promise.all([
      fetch(`https://api.brightsky.dev/current_weather?${q}`).then((r) => r.json()),
      fetch(`https://api.brightsky.dev/weather?${q}&date=${von.toISOString()}&last_date=${bis.toISOString()}`).then((r) => r.json()),
    ]);
    const w = jetzt.weather;
    const std = vorhersage.weather as { timestamp: string; wind_speed: number; wind_gust_speed: number }[];
    return {
      current: { time: w.timestamp, wind_speed_10m: erster(w.wind_speed_10, w.wind_speed_30, w.wind_speed_60), wind_gusts_10m: erster(w.wind_gust_speed_10, w.wind_gust_speed_30, w.wind_gust_speed_60), wind_direction_10m: erster(w.wind_direction_10, w.wind_direction_30, w.wind_direction_60) },
      hourly: { time: std.map((x) => x.timestamp), wind_speed_10m: std.map((x) => x.wind_speed ?? 0), wind_gusts_10m: std.map((x) => x.wind_gust_speed ?? 0) },
    };
  }

  function laden(ort: Ort, proxy: string) {
    const key = `${proxy}|${ort.id}`;
    if (!cache.has(key)) {
      cache.set(key, proxy
        ? fetch(`${proxy}?ort=${ort.id}`).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        : brightSky(ort));
    }
    return cache.get(key)!;
  }

  for (const el of document.querySelectorAll<HTMLElement>('.drachenwetter')) {
    const { orte, proxy, t, lang } = JSON.parse(el.dataset.config!) as { orte: Ort[]; proxy: string; t: any; lang: string };
    const $ = (k: string) => el.querySelector<HTMLElement>(`[data-w="${k}"]`);
    const kompakt = el.dataset.variante === 'kompakt';

    async function zeigen(ort: Ort) {
      try {
        const d = await laden(ort, proxy);
        const b = bft(d.current.wind_speed_10m);
        const bb = bft(d.current.wind_gusts_10m);
        const z = zone(b);
        const urteil = { wenig: t.zuWenig, gut: t.gut, viel: t.zuViel }[z];
        $('bft')!.textContent = String(b);
        if (kompakt) { $('urteil')!.textContent = `${urteil}`; $('bft')!.style.background = farbe(b); return; }

        const richtung = t.richtungen[Math.round(d.current.wind_direction_10m / 45) % 8];
        $('kreis')!.style.background = farbe(b);
        $('pfeil')!.style.transform = `rotate(${d.current.wind_direction_10m + 180}deg)`;
        $('beschreibung')!.textContent = t.beaufort[b].charAt(0).toUpperCase() + t.beaufort[b].slice(1);
        $('details')!.textContent = `${Math.round(d.current.wind_speed_10m)} ${t.kmh} ${t.aus} ${richtung} · ${t.boeen} ${Math.round(d.current.wind_gusts_10m)} ${t.kmh}`;
        const u = $('urteil')!; u.textContent = urteil; u.style.background = farbe(b);
        $('urteilText')!.textContent = { wenig: t.zuWenigText, gut: t.gutText, viel: t.zuVielText }[z];
        const boe = $('boeen')!;
        boe.classList.toggle('hidden', !(z !== 'viel' && bb >= 5));
        boe.textContent = t.boeWarnung.replace('{bft}', String(bb));
        const pos = (x: number) => `${((Math.min(x, 8) + 0.5) / 9) * 100}%`;
        const m = $('marker')!; m.classList.remove('hidden'); m.style.left = pos(b);
        const bm = $('boemarker')!; bm.classList.toggle('hidden', bb === b); bm.style.left = pos(bb);

        // Stundenbalken
        const jetzt = d.current.time.slice(0, 13);
        const start = Math.max(0, d.hourly.time.findIndex((x) => x.slice(0, 13) >= jetzt));
        const stunden = $('stunden')!; stunden.replaceChildren();
        d.hourly.time.slice(start, start + 12).forEach((zeit, i) => {
          const hb = bft(d.hourly.wind_speed_10m[start + i]);
          const col = document.createElement('div');
          col.className = 'flex h-full flex-col items-center justify-end gap-1';
          col.title = `${zeit.slice(11, 16)}: ${hb} Bft`;
          col.innerHTML = `<span class="text-xs font-bold text-navy">${hb}</span><span class="flex h-20 w-full items-end"><span class="block w-full rounded-t-lg rounded-b-sm" style="height:${Math.max(6, (Math.min(hb, 8) / 8) * 100)}%;background:${farbe(hb)}"></span></span><span class="text-[11px] text-navy-950/70">${zeit.slice(11, 13)}</span>`;
          stunden.append(col);
        });
      } catch {
        if (kompakt) { $('urteil')!.textContent = t.titel; return; }
        $('beschreibung')!.textContent = t.fehler;
      }
    }

    el.querySelectorAll<HTMLButtonElement>('[data-ort]').forEach((btn) => btn.addEventListener('click', () => {
      el.querySelectorAll('[data-ort]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      zeigen(orte.find((o) => o.id === btn.dataset.ort)!);
    }));
    zeigen(orte[0]);
    void lang;
  }
</script>
