---
/**
 * Drachenwetter: aktueller Wind in km/h mit Ampel (gut bis 28 km/h = Windstärke 4), Böen, Richtung
 * und Vorhersage nach Tageszeiten für heute und morgen.
 * Datenquelle: Deutscher Wetterdienst über Bright Sky (frei nutzbar, auch kommerziell). Standard ist der
 * Server-Proxy /api/wind.php (passt zur CSP, Browser kontaktiert keine Dritten). Nur beim lokalen Entwickeln
 * (`npm run dev`) oder mit PUBLIC_WIND_DIREKT=1 fragt der Browser Bright Sky direkt.
 */
import { laeden } from '../lib/laden';
import { u } from '../lib/url';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang?: Lang; variante?: 'gross' | 'kompakt'; link?: string }
const { lang = 'de', variante = 'gross', link } = Astro.props;
const t = ui[lang].wind;
const orte = [...laeden].reverse().map((l) => ({ id: l.id, name: l.ort, lat: l.lat, lon: l.lon })); // Schillig (Strand) zuerst
const direkt = import.meta.env.DEV || !!import.meta.env.PUBLIC_WIND_DIREKT;
const proxy = direkt ? '' : u('/api/wind.php');
const config = JSON.stringify({ orte, proxy, t });
// Skala 0–50 km/h: Zonen zu wenig (<6), gut (6–28), zu viel (>28)
const skala = [
  { von: 0, bis: 6, farbe: 'var(--wind-wenig-hell)' },
  { von: 6, bis: 28, farbe: 'var(--wind-gut-hell)' },
  { von: 28, bis: 50, farbe: 'var(--wind-viel-hell)' },
];
---
{variante === 'kompakt' ? (
  <a href={link} class="drachenwetter inline-flex items-center gap-3 rounded-lg border-2 border-sand-100/70 bg-navy-900 py-1.5 pl-1.5 pr-4 text-white no-underline hover:border-sand" data-config={config} data-variante="kompakt">
    <span data-w="wert" class="grid h-11 min-w-11 place-items-center rounded-md bg-navy-700 px-2 font-display text-sm font-bold">–</span>
    <span class="text-sm leading-tight"><span class="block text-white/80">{t.jetzt} in {orte[0].name}</span><span data-w="urteil" class="font-semibold">{t.laedt}</span></span>
  </a>
) : (
  <div id="drachenwetter" class="drachenwetter scroll-mt-24 overflow-hidden rounded-lg bg-white ring-1 ring-navy/15" data-config={config} data-variante="gross">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-navy/10 px-6 py-5 md:px-10">
      <h2 class="text-3xl md:text-4xl">{t.titel}</h2>
      <div class="flex rounded-lg border-2 border-navy" role="group" aria-label={t.ort}>
        {orte.map((o, i) => (
          <button type="button" data-ort={o.id} aria-pressed={i === 0 ? 'true' : 'false'} class="px-4 py-2 text-sm font-semibold text-navy aria-pressed:bg-navy aria-pressed:text-white">{o.name}</button>
        ))}
      </div>
    </div>

    <div class="grid gap-8 p-6 md:grid-cols-[auto_1fr] md:gap-12 md:p-10">
      <!-- Aktueller Wert -->
      <div class="flex flex-wrap items-center gap-6">
        <div data-w="kreis" class="relative grid h-36 w-36 shrink-0 place-items-center rounded-full text-white transition-colors md:h-44 md:w-44" style="background: var(--wind-leer)">
          <div class="text-center">
            <span data-w="wert" class="block font-display text-5xl font-bold leading-none md:text-6xl">–</span>
            <span class="text-sm font-semibold">{t.kmh}</span>
          </div>
          <svg data-w="pfeil" class="absolute -right-2 -top-2 h-12 w-12 rounded-full bg-white p-2 text-navy transition-transform duration-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l5 14-5-3-5 3z" /></svg>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-semibold uppercase tracking-wider text-navy-950/70">{t.jetzt}</p>
          <p data-w="beschreibung" class="font-display text-2xl font-bold text-navy">{t.laedt}</p>
          <p data-w="details" class="mt-1 text-navy-950/75"></p>
        </div>
      </div>

      <!-- Urteil + Skala -->
      <div class="flex flex-col justify-center" aria-live="polite" aria-atomic="true">
        <p data-w="urteil" class="inline-flex self-start rounded-lg px-3 py-1.5 text-sm font-bold text-white" style="background: var(--wind-leer)">…</p>
        <p data-w="urteilText" class="mt-3 text-lg leading-relaxed text-navy-950/85"></p>
        <p data-w="boeen" class="mt-3 hidden rounded-md bg-signal/10 px-4 py-3 text-sm font-medium text-[#9e2f20]"></p>

        <div class="mt-8" aria-hidden="true">
          <div class="relative h-4">
            <div class="flex h-4 gap-1">
              {skala.map((z) => <div class="h-4 rounded-full" style={`flex:${z.bis - z.von}; background:${z.farbe}`}></div>)}
            </div>
            <div data-w="marker" class="absolute -top-3 hidden h-10 w-1.5 -translate-x-1/2 rounded-full bg-navy shadow ring-2 ring-white transition-[left] duration-700"></div>
            <div data-w="boemarker" class="absolute -top-2 hidden h-8 w-0 -translate-x-1/2 border-l-2 border-dashed border-navy/70 transition-[left] duration-700"></div>
          </div>
          <div class="relative mt-2 h-4 text-xs font-semibold text-navy-950/70">
            {[0, 6, 28, 50].map((k) => <span class="absolute -translate-x-1/2" style={`left:${(k / 50) * 100}%`}>{k === 50 ? '50+' : k}</span>)}
          </div>
          <div class="mt-1 flex text-[11px] uppercase tracking-wider">
            <span style="flex:6"></span>
            <span class="text-center font-bold" style="flex:22; color: var(--wind-gut)">{t.zone[1]}</span>
            <span class="text-center" style="flex:22; color: var(--wind-viel)">{t.zone[2]}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tageszeiten heute / morgen -->
    <div class="border-t border-navy/10 px-4 py-6 md:px-10">
      <table class="w-full table-fixed border-separate border-spacing-1 text-center md:border-spacing-2">
        <thead>
          <tr>
            <th class="w-16 md:w-28"><span class="sr-only">Tag</span></th>
            {t.tageszeiten.map((z) => <th scope="col" class="text-[10px] font-semibold uppercase tracking-wide text-navy-950/70 sm:text-xs md:text-sm">{z}</th>)}
          </tr>
        </thead>
        <tbody data-w="tageszeiten">
          {[t.heute, t.morgen].map((tag) => (
            <tr>
              <th scope="row" class="text-left text-sm font-semibold text-navy">{tag}</th>
              {t.tageszeiten.map(() => <td class="rounded-xl bg-sand-100 py-3 text-sm text-navy-950/70">–</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Regel -->
    <div class="flex gap-4 bg-navy px-6 py-6 text-white md:px-10">
      <svg class="mt-0.5 h-7 w-7 shrink-0 text-sand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <div>
        <p class="font-display text-lg font-bold text-sand">{t.regelTitel}</p>
        <p class="mt-1 text-lg leading-relaxed">{t.regel}</p>
      </div>
    </div>
    <p class="px-6 py-3 text-right text-xs text-navy-950/70 md:px-10">{t.quelle}: <a href="https://www.dwd.de/" rel="noopener" class="underline">Deutscher Wetterdienst</a>, über <a href="https://brightsky.dev/" rel="noopener" class="underline">Bright Sky</a> · {t.messung}</p>
  </div>
)}

<style is:global>
  :root {
    /* kräftige Farben (weiße Schrift, Kontrast ≥ 4,5) und helle Varianten für die Skala */
    --wind-wenig: #4a6784; --wind-gut: #1d7650; --wind-viel: #b23a29; --wind-leer: #6b7787;
    --wind-wenig-hell: #b7c8d8; --wind-gut-hell: #5fb98e; --wind-viel-hell: #e08a7c;
  }
</style>

<script>
  import { heuteBerlin } from '../lib/zeit';
  import { messen } from '../lib/messen';
  type Ort = { id: string; name: string; lat: number; lon: number };
  type Daten = { current: { time: string; wind_speed_10m: number; wind_gusts_10m: number; wind_direction_10m: number }; hourly: { time: string[]; wind_speed_10m: number[]; wind_gusts_10m: number[] } };

  const GUT_MIN = 6, GUT_MAX = 28, BOE_WARNUNG = 38, SKALA_MAX = 50;
  const BFT_GRENZEN = [1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118];
  const bft = (kmh: number) => { const i = BFT_GRENZEN.findIndex((g) => kmh < g); return i === -1 ? 12 : i; };
  const zone = (kmh: number) => (kmh < GUT_MIN ? 'wenig' : kmh <= GUT_MAX ? 'gut' : 'viel');
  const farbe = (kmh: number) => `var(--wind-${zone(kmh)})`;
  // Tageszeiten: Stunden [von, bis)
  const TAGESZEITEN: [number, number][] = [[6, 11], [11, 14], [14, 18], [18, 22]];
  const cache = new Map<string, Promise<Daten>>();

  function berlinHeute() {
    const heute = heuteBerlin();
    const morgen = heuteBerlin(new Date(Date.now() + 24 * 3600e3));
    const stunde = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Berlin', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
    return { heute, morgen, stunde };
  }

  // Bright Sky (DWD): aktuelle Messung der nächsten Station + stündliche Werte für heute und morgen
  const erster = (...w: (number | null | undefined)[]) => w.find((x) => typeof x === 'number') ?? 0;
  async function brightSky(ort: Ort): Promise<Daten> {
    const q = `lat=${ort.lat}&lon=${ort.lon}&tz=Europe/Berlin`;
    const { heute } = berlinHeute();
    const uebermorgen = new Date(`${heute}T12:00:00Z`); uebermorgen.setUTCDate(uebermorgen.getUTCDate() + 2);
    const [jetzt, vorhersage] = await Promise.all([
      fetch(`https://api.brightsky.dev/current_weather?${q}`).then((r) => r.json()),
      fetch(`https://api.brightsky.dev/weather?${q}&date=${heute}&last_date=${uebermorgen.toISOString().slice(0, 10)}`).then((r) => r.json()),
    ]);
    const w = jetzt.weather;
    const std = vorhersage.weather as { timestamp: string; wind_speed: number | null; wind_gust_speed: number | null }[];
    return {
      current: { time: w.timestamp, wind_speed_10m: erster(w.wind_speed_10, w.wind_speed_30, w.wind_speed_60), wind_gusts_10m: erster(w.wind_gust_speed_10, w.wind_gust_speed_30, w.wind_gust_speed_60), wind_direction_10m: erster(w.wind_direction_10, w.wind_direction_30, w.wind_direction_60) },
      hourly: { time: std.map((x) => x.timestamp), wind_speed_10m: std.map((x) => x.wind_speed ?? 0), wind_gusts_10m: std.map((x) => x.wind_gust_speed ?? 0) },
    };
  }

  function laden(ort: Ort, proxy: string) {
    const key = `${proxy}|${ort.id}`;
    if (!cache.has(key)) {
      cache.set(key, proxy
        ? fetch(`${proxy}?ort=${ort.id}`).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        : brightSky(ort));
    }
    return cache.get(key)!;
  }

  /** Mittelwert Wind und max. Böe je Tageszeit, Datum im Format YYYY-MM-DD */
  function tageszeit(d: Daten, datum: string, [von, bis]: [number, number]) {
    const idx = d.hourly.time.map((zeit, i) => ({ zeit, i })).filter(({ zeit }) => zeit.slice(0, 10) === datum && +zeit.slice(11, 13) >= von && +zeit.slice(11, 13) < bis).map(({ i }) => i);
    if (!idx.length) return null;
    const wind = idx.reduce((s, i) => s + d.hourly.wind_speed_10m[i], 0) / idx.length;
    const boe = Math.max(...idx.map((i) => d.hourly.wind_gusts_10m[i]));
    return { wind: Math.round(wind), boe: Math.round(boe) };
  }

  for (const el of document.querySelectorAll<HTMLElement>('.drachenwetter')) {
    const { orte, proxy, t } = JSON.parse(el.dataset.config!) as { orte: Ort[]; proxy: string; t: any };
    const $ = (k: string) => el.querySelector<HTMLElement>(`[data-w="${k}"]`);
    const kompakt = el.dataset.variante === 'kompakt';

    async function zeigen(ort: Ort) {
      try {
        const d = await laden(ort, proxy);
        const kmh = Math.round(d.current.wind_speed_10m);
        const boe = Math.round(d.current.wind_gusts_10m);
        const z = zone(kmh);
        const urteil = { wenig: t.zuWenig, gut: t.gut, viel: t.zuViel }[z];
        $('wert')!.textContent = kompakt ? `${kmh} ${t.kmh}` : String(kmh);
        if (kompakt) { $('urteil')!.textContent = urteil; $('wert')!.style.background = farbe(kmh); return; }

        const b = bft(kmh);
        const richtung = t.richtungen[Math.round(d.current.wind_direction_10m / 45) % 8];
        $('kreis')!.style.background = farbe(kmh);
        $('pfeil')!.style.transform = `rotate(${d.current.wind_direction_10m + 180}deg)`;
        $('beschreibung')!.textContent = `${t.beaufort[b].charAt(0).toUpperCase()}${t.beaufort[b].slice(1)} · ${b} Bft`;
        $('details')!.textContent = `${t.aus} ${richtung} · ${t.boeen} ${boe} ${t.kmh}`;
        const u = $('urteil')!; u.textContent = `${urteil}: ${kmh} ${t.kmh}`; u.style.background = farbe(kmh);
        $('urteilText')!.textContent = { wenig: t.zuWenigText, gut: t.gutText, viel: t.zuVielText }[z];
        const warnung = $('boeen')!;
        warnung.classList.toggle('hidden', !(z !== 'viel' && boe > BOE_WARNUNG));
        warnung.textContent = t.boeWarnung.replace('{kmh}', String(boe));
        const pos = (x: number) => `${(Math.min(x, SKALA_MAX) / SKALA_MAX) * 100}%`;
        const m = $('marker')!; m.classList.remove('hidden'); m.style.left = pos(kmh);
        const bm = $('boemarker')!; bm.classList.toggle('hidden', boe <= kmh); bm.style.left = pos(boe);

        // Tageszeiten heute + morgen
        const { heute, morgen, stunde } = berlinHeute();
        const zeilen = $('tageszeiten')!.querySelectorAll('tr');
        [heute, morgen].forEach((datum, r) => {
          zeilen[r].querySelectorAll('td').forEach((td, k) => {
            const [von, bis] = TAGESZEITEN[k];
            td.replaceChildren();
            td.removeAttribute('style');
            if (datum === heute && stunde >= bis) {
              td.className = 'rounded-xl bg-sand-100 py-3 text-xs text-navy-950/70';
              td.textContent = t.vorbei;
              return;
            }
            const w = tageszeit(d, datum, [von, bis]);
            if (!w) { td.textContent = '–'; return; }
            td.className = 'rounded-xl py-2.5 text-white';
            td.style.background = farbe(w.wind);
            const wert = document.createElement('span');
            wert.className = 'block font-display text-lg font-bold leading-tight md:text-xl';
            wert.textContent = String(w.wind);
            const einheit = document.createElement('span');
            einheit.className = 'block text-[11px] leading-tight';
            einheit.textContent = t.kmh;
            const sr = document.createElement('span');
            sr.className = 'sr-only';
            sr.textContent = `, ${t.boeen} ${w.boe} ${t.kmh}`;
            td.title = `${t.boeen} ${w.boe} ${t.kmh}`;
            td.append(wert, einheit, sr);
          });
        });
      } catch {
        if (kompakt) { $('urteil')!.textContent = t.titel; return; }
        $('beschreibung')!.textContent = t.fehler;
      }
    }

    el.querySelectorAll<HTMLButtonElement>('[data-ort]').forEach((btn) => btn.addEventListener('click', () => {
      el.querySelectorAll('[data-ort]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      zeigen(orte.find((o) => o.id === btn.dataset.ort)!);
      messen('drachenwetter_ort', { ort: btn.dataset.ort! });
    }));
    zeigen(orte[0]);
  }
</script>
