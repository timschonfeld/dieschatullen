---
import { Image } from 'astro:assets';
import OpenStatus from './OpenStatus.astro';
import { bild } from '../lib/bilder';
import { routenLink, telLink, site, type Laden, istWinterpause } from '../lib/laden';

interface Props { laden: Laden; foto: string; headingLevel?: 'h2' | 'h3' }
const { laden, foto, headingLevel: H = 'h3' } = Astro.props;
---
<article id={laden.id} class="flex scroll-mt-24 flex-col overflow-hidden rounded-lg bg-white ring-1 ring-navy/15">
  <div class="relative">
    <Image src={bild(foto)} alt={`Ladenansicht ${laden.name}`} widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[3/2] w-full object-cover" />
    <OpenStatus laden={laden} class="absolute bottom-4 left-4" />
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <p class="eyebrow mb-1">{laden.ort} · seit {laden.seit}</p>
    <H class="mb-3 text-2xl sm:text-3xl">{laden.name}</H>
    <p class="mb-5 leading-relaxed text-navy-950/80">{laden.text}</p>
    <ul class="mb-6 flex flex-wrap gap-2 text-sm">
      {laden.besonderheiten.map((b) => <li class="etikett">{b}</li>)}
    </ul>

    <div class="mt-auto grid gap-6 border-t border-navy/10 pt-6 sm:grid-cols-2">
      <div>
        <h4 class="mb-2 text-sm font-semibold text-navy">Öffnungszeiten</h4>
        {istWinterpause() ? (
          <p class="text-sm">Winterpause</p>
        ) : (
          <dl class="space-y-1 text-sm">
            {laden.oeffnungszeiten.map((o) => (
              <div class="flex justify-between gap-3"><dt>{o.label}</dt><dd class="tabular-nums">{o.von}–{o.bis}</dd></div>
            ))}
          </dl>
        )}
      </div>
      <div>
        <h4 class="mb-2 text-sm font-semibold text-navy">Adresse</h4>
        <address class="text-sm not-italic leading-relaxed">
          {laden.strasse}<br />{laden.plz} {laden.ort}<br />
          <a href={telLink(laden.telefon)} class="font-medium text-navy">{laden.telefon}</a>
        </address>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={routenLink(laden)} class="btn-primary" rel="noopener">Route planen</a>
      <a href={telLink(laden.telefon)} class="btn-ghost">Anrufen</a>
    </div>
  </div>
</article>
