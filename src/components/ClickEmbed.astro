---
/**
 * Externer Inhalt (Google-360°-Rundgang, YouTube) – lädt erst nach Einwilligung:
 * - im Einwilligungs-Banner (CCM19) erlaubt → lädt direkt beim Seitenaufruf (ohne Autoplay)
 * - sonst Platzhalter mit „Einmal laden“ und „Immer erlauben“ (öffnet die Cookie-Einstellungen)
 * `dienst` muss dem Namen der Einbindung in CCM19 entsprechen („Google Maps“, „YouTube“).
 */
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: string; titel: string; anbieter: string; dienst: 'Google Maps' | 'YouTube'; ereignis: 'rundgang_start' | 'video_start'; poster: ImageMetadata; alt: string }
const { src, titel, anbieter, dienst, ereignis, poster, alt } = Astro.props;
// Nur bekannte, sichere Quellen zulassen (Inhalte kommen aus dem CMS)
const erlaubt = /^https:\/\/(www\.google\.com\/maps\/embed\?|www\.youtube-nocookie\.com\/embed\/[\w-]{11}(\?|$))/;
if (!erlaubt.test(src)) throw new Error(`ClickEmbed: Quelle nicht erlaubt: ${src}`);
---
<div class="click-embed relative aspect-video overflow-hidden rounded-lg bg-navy-900" data-src={src} data-titel={titel} data-dienst={dienst} data-ereignis={ereignis}>
  <Image src={poster} alt={alt} widths={[640, 1000]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover opacity-60" />
  <div class="relative flex h-full flex-col items-center justify-center gap-3 p-6 text-center">
    <button type="button" data-laden class="btn-hell">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      {titel}
    </button>
    <p class="max-w-sm text-xs text-white/90">
      Beim Klick wird Inhalt von {anbieter} geladen, dabei werden Daten an {anbieter} übertragen. Mehr dazu in der <a href={u('/datenschutz/')} class="text-white underline">Datenschutzerklärung</a>.
    </p>
    <button type="button" data-immer hidden class="text-xs text-white underline">Inhalte von {anbieter} immer erlauben</button>
  </div>
</div>

<script>
  import { messen } from '../lib/messen';

  type CCM = { acceptedEmbeddings?: { name: string }[]; openControlPanel?: () => void };
  const ccm = () => (window as unknown as { CCM?: CCM }).CCM;
  const erlaubtIn = (dienst: string) => (ccm()?.acceptedEmbeddings ?? []).some((e) => e.name.toLowerCase().includes(dienst.toLowerCase()));

  function laden(el: HTMLElement, autoplay: boolean) {
    if (el.dataset.geladen) return;
    el.dataset.geladen = '1';
    const f = document.createElement('iframe');
    // Beim automatischen Laden (Einwilligung vorhanden) kein Autoplay, sonst starten alle Videos gleichzeitig
    f.src = autoplay ? el.dataset.src! : el.dataset.src!.replace(/([?&])autoplay=1&?/, '$1').replace(/[?&]$/, '');
    f.title = el.dataset.titel!;
    f.className = 'absolute inset-0 h-full w-full border-0';
    f.allow = 'fullscreen; accelerometer; gyroscope';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    el.replaceChildren(f);
    return f;
  }

  const embeds = [...document.querySelectorAll<HTMLElement>('.click-embed')];
  for (const el of embeds) {
    el.querySelector('[data-laden]')?.addEventListener('click', () => {
      laden(el, true)?.focus();
      messen(el.dataset.ereignis!);
    });
    el.querySelector('[data-immer]')?.addEventListener('click', () => ccm()?.openControlPanel?.());
  }

  /** Bereits erlaubte Dienste laden, „Immer erlauben“ nur zeigen, wenn der Banner (CCM19) da ist. */
  function pruefen() {
    for (const el of embeds) {
      if (erlaubtIn(el.dataset.dienst!)) laden(el, false);
      const immer = el.querySelector<HTMLButtonElement>('[data-immer]');
      if (immer) immer.hidden = !ccm()?.openControlPanel;
    }
  }
  pruefen();
  window.addEventListener('ccm19WidgetLoaded', pruefen);
  window.addEventListener('ccm19EmbeddingAccepted', pruefen);
  window.addEventListener('ccm19WidgetClosed', pruefen);
</script>
