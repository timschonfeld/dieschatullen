---
/**
 * Zeigt "Jetzt geöffnet · bis 18 Uhr" o. ä. Die Berechnung läuft im Browser (Europe/Berlin),
 * damit der Status auch auf einer statischen Seite immer aktuell ist.
 */
import { site, istWinterpause, type Laden } from '../lib/laden';
import { ui, tageLabel, type Lang } from '../i18n/ui';

interface Props { laden: Laden; class?: string; lang?: Lang }
const { laden, class: cls = '', lang = 'de' } = Astro.props;
const t = ui[lang];
const texte = { winterpause: t.winterpause, offen: t.offen, zuHeute: t.zuHeute, zuMorgen: t.zuMorgen, zuTag: t.zuTag, tage: t.tage, lang };
const daten = JSON.stringify({ zeiten: laden.oeffnungszeiten, winterpause: site.saison.winterpause, von: site.saison.winterpauseVon, bis: site.saison.winterpauseBis, ausnahmen: site.ausnahmen, texte });
const fallback = istWinterpause()
  ? t.winterpause
  : laden.oeffnungszeiten.map((o) => `${lang === 'de' ? o.label : tageLabel(o.tage, lang)} ${o.von}–${o.bis}`).join(' · ');
---
<p class={`open-status inline-flex items-center gap-2 rounded-lg bg-white px-3 py-1.5 text-sm font-semibold text-navy ${cls}`} data-oeffnung={daten}>
  <span class="dot h-2.5 w-2.5 shrink-0 rounded-full bg-navy/30" aria-hidden="true"></span>
  <span class="label">{fallback}</span>
</p>

<script>
  type Zeit = { tage: number[]; von: string; bis: string };
  type Texte = { winterpause: string; offen: string; zuHeute: string; zuMorgen: string; zuTag: string; tage: string[]; lang: string };
  const minuten = (hm: string) => { const [h, m] = hm.split(':').map(Number); return h * 60 + m; };

  function berlinJetzt() {
    const teile = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Europe/Berlin', year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date());
    const w = (t: string) => teile.find((p) => p.type === t)!.value;
    const datum = `${w('year')}-${w('month')}-${w('day')}`;
    return { datum, tag: new Date(`${datum}T12:00:00Z`).getUTCDay(), min: Number(w('hour')) * 60 + Number(w('minute')) };
  }
  const addTage = (datum: string, n: number) => { const d = new Date(`${datum}T12:00:00Z`); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };

  for (const el of document.querySelectorAll<HTMLElement>('.open-status')) {
    const { zeiten, winterpause, von, bis, ausnahmen, texte: t } = JSON.parse(el.dataset.oeffnung!) as { zeiten: Zeit[]; winterpause: boolean; von: string; bis: string; ausnahmen: { datum: string }[]; texte: Texte };
    // 10:00 → „10“, 17:30 → „17:30“ (DE/NL); Englisch bleibt bei 10:00
    const zeit = (hm: string) => (t.lang === 'en' ? hm : hm.replace(/^0/, '').replace(':00', ''));
    const satz = (vorlage: string, z: Zeit, tag?: number) =>
      vorlage.replace('{von}', zeit(z.von)).replace('{bis}', zeit(z.bis)).replace('{tag}', tag === undefined ? '' : t.tage[tag]);
    const label = el.querySelector('.label')!;
    const dot = el.querySelector('.dot')!;
    const jetzt = berlinJetzt();
    const inPause = (datum: string) => !!von && !!bis && datum >= von && datum <= bis;
    if (winterpause || inPause(jetzt.datum)) { label.textContent = t.winterpause; dot.className = 'dot h-2.5 w-2.5 shrink-0 rounded-full bg-signal'; continue; }
    const zu = (datum: string) => ausnahmen.some((a) => a.datum === datum) || inPause(datum);
    const heute = zeiten.find((z) => z.tage.includes(jetzt.tag));

    if (heute && !zu(jetzt.datum) && jetzt.min >= minuten(heute.von) && jetzt.min < minuten(heute.bis)) {
      label.textContent = satz(t.offen, heute);
      dot.className = 'dot h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500';
      continue;
    }
    dot.className = 'dot h-2.5 w-2.5 shrink-0 rounded-full bg-signal';
    if (heute && !zu(jetzt.datum) && jetzt.min < minuten(heute.von)) {
      label.textContent = satz(t.zuHeute, heute);
      continue;
    }
    for (let i = 1; i <= 7; i++) {
      const tag = (jetzt.tag + i) % 7;
      const z = zeiten.find((z) => z.tage.includes(tag));
      if (z && !zu(addTage(jetzt.datum, i))) {
        label.textContent = satz(i === 1 ? t.zuMorgen : t.zuTag, z, tag);
        break;
      }
    }
  }
</script>
