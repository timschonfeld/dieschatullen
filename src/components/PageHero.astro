---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Steuerrad from './Steuerrad.astro';

interface Props { eyebrow?: string; titel: string; intro?: string; foto?: ImageMetadata; alt?: string }
const { eyebrow, titel, intro, foto, alt = '' } = Astro.props;
---
{foto ? (
  <section class="full-bleed">
    <div class="relative h-[60svh] min-h-[400px] md:h-[72svh]">
      <Image src={foto} alt={alt} widths={[480, 828, 1200, 1800, 2400]} sizes="100vw" format="avif" quality={55} class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/30 to-transparent"></div>
      <div class="container-page relative flex h-full flex-col justify-end pb-12 md:pb-16">
        {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-sand">{eyebrow}</p>}
        <h1 class="display-lg max-w-4xl !text-white">{titel}</h1>
      </div>
    </div>
    {(intro || Astro.slots.has('default')) && (
      <div class="container-page mt-10 max-w-3xl md:mt-14">
        {intro && <p class="text-xl leading-relaxed text-navy-950/80 md:text-2xl">{intro}</p>}
        <slot />
      </div>
    )}
  </section>
) : (
  <section class="container-page relative pt-14 md:pt-24">
    <Steuerrad class="-right-24 -top-10 h-72 w-72 opacity-[0.06] md:-right-10 md:h-[28rem] md:w-[28rem]" />
    <div class="relative max-w-4xl">
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h1 class="display-lg">{titel}</h1>
      {intro && <p class="mt-6 text-xl leading-relaxed text-navy-950/80 md:text-2xl">{intro}</p>}
      <slot />
    </div>
  </section>
)}
