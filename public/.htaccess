# --- Die Schatullen: statische Astro-Seite auf Hetzner Webhosting (Apache) ---
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# HTTPS erzwingen (Host bleibt erhalten, z. B. auch für neu.dieschatullen.de; lokal ausgenommen)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www. entfernen
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Alte WordPress-URLs
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^faq/?$ /faqs/ [L,R=301]
RewriteRule ^drachen/?$ /drachen-und-drachenreparatur/ [L,R=301]
RewriteRule ^(feed|comments/feed|wp-login\.php|wp-admin|xmlrpc\.php|wp-json)(/.*)?$ - [G,L]

# Caching: HTML immer frisch, gehashte Astro-Dateien 1 Jahr, sonstige Bilder 1 Woche
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Sicherheits-Header
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
