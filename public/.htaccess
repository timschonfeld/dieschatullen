# --- Die Schatullen: statische Astro-Seite auf Hetzner Webhosting (Apache) ---
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# HTTPS + ohne www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dieschatullen.de%{REQUEST_URI} [L,R=301]

# Alte WordPress-URLs
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^faq/?$ /faqs/ [L,R=301]
RewriteRule ^drachen/?$ /drachen-und-drachenreparatur/ [L,R=301]
RewriteRule ^(feed|comments/feed|wp-login\.php|wp-admin|xmlrpc\.php|wp-json)(/.*)?$ - [G,L]

# Caching: HTML immer frisch, gehashte Astro-Dateien 1 Jahr, sonstige Bilder 1 Woche
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
