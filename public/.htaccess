# --- Die Schatullen: statische Astro-Seite auf Hetzner Webhosting (Apache) ---
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# Eine Adresse für alles: www. und alle Zweit-Domains (die-schatullen.de, hooksieler-schatulle.de …)
# mit einem Schritt auf https://dieschatullen.de. Staging und lokal ausgenommen.
RewriteCond %{HTTP_HOST} !^(dieschatullen\.de|neu\.dieschatullen\.de|localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://dieschatullen.de%{REQUEST_URI} [L,R=301]
# HTTPS erzwingen (Host bleibt erhalten, also auch für neu.dieschatullen.de)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Alte WordPress-URLs
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^faq/?$ /faqs/ [L,R=301]
RewriteRule ^drachen/?$ /drachen-und-drachenreparatur/ [L,R=301]
RewriteRule ^(feed|comments/feed|wp-login\.php|wp-admin|xmlrpc\.php|wp-json)(/.*)?$ - [G,L]

# Caching: HTML immer frisch, gehashte Astro-Dateien 1 Jahr, sonstige Bilder 1 Woche
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Sicherheits-Header
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  # CCM19 (Einwilligung, consent.dieschatullen.de) und Google Analytics (lädt erst nach Einwilligung über CCM19)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://consent.dieschatullen.de https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://consent.dieschatullen.de; img-src 'self' data: https://consent.dieschatullen.de https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; font-src 'self' https://consent.dieschatullen.de; connect-src 'self' https://consent.dieschatullen.de https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.google.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
